        event.currentTarget.classList.add('active');
    }

    function analyzeABGA() {
        const ph = parseFloat(document.getElementById('ext_ph').value);
        const paco2 = parseFloat(document.getElementById('ext_paco2').value);
        const hco3 = parseFloat(document.getElementById('ext_hco3').value);
        const resBox = document.getElementById('ext_abga_res');
        if (!ph || !paco2 || !hco3) { alert('수치를 모두 입력해주세요.'); return; }
        let diag = ph < 7.35 ? (paco2 > 45 ? '호흡성 산증 (Respiratory Acidosis)' : '대사성 산증 (Metabolic Acidosis)') : (ph > 7.45 ? (paco2 < 35 ? '호흡성 알칼리증' : '대사성 알칼리증') : '정상 범위');
        resBox.style.display = 'block';
        resBox.innerHTML = `<strong>[ABGA 정밀 판독]</strong> ${diag}<br>• 임상적 의미: 환자의 폐 환기 상태와 신장의 대사적 보상 능력을 평가한 결과입니다.`;
    }

    function calcIOBalance() {
        const intake = parseFloat(document.getElementById('ext_io_in').value) || 0;
        const output = parseFloat(document.getElementById('ext_io_out').value) || 0;
        const wt = parseFloat(document.getElementById('ext_wt').value) || 0;
        const resBox = document.getElementById('ext_io_res');
        const net = intake - output;
        let typeStr = net > 0 ? 'Positive Balance (수분 저류 상태)' : (net < 0 ? 'Negative Balance (수분 배설 우위)' : 'Balanced');
        let sign = net > 0 ? '+' : '';
        let status = net > 1000 ? '⚠️ 과수분(Fluid Overload) 위험 - 부종 및 호흡곤란 모니터링 필요' : (net < -500 ? '⚠️ 탈수(Dehydration) 위험 - 신장 퍼퓨전 및 혈압 체크 필요' : '양호한 체액 균형 유지 중');

        resBox.style.display = 'block';
        resBox.innerHTML = `<strong>Net Balance:</strong> ${sign}${net} mL [${typeStr}]<br><strong>체중 변화:</strong> ${wt >= 0 ? '+' : ''}${wt} kg<br><strong>평가 및 중재:</strong> ${status}`;
    }

    function calcCrCl() {
        const gender = document.getElementById('ext_gender').value;
        const age = parseFloat(document.getElementById('ext_age').value);
        const wt = parseFloat(document.getElementById('ext_wt_val').value);
        const cr = parseFloat(document.getElementById('ext_cr').value);
        const resBox = document.getElementById('ext_crcl_res');

        if (!age || !wt || !cr) { alert('나이, 체중, Cr을 모두 입력하세요.'); return; }
        let crcl = ((140 - age) * wt) / (72 * cr);
        if (gender === 'female') crcl *= 0.85;

        let guide = crcl >= 50 ? '정상 용량 투여 가능' : (crcl >= 30 ? '약물 용량 감량(Dose reduction) 검토 필요' : '신독성 약물 주의 및 주치의 용량 조절 필수');
        let notiTemplate = '';
        if (crcl < 50) {
            notiTemplate = `<br><br><strong>[SBAR 노티 템플릿]</strong><br>• S: 환자 CrCl ${crcl.toFixed(1)} mL/min으로 저하 확인.<br>• B: 신장 배설 약물의 체내 축적 및 독성 위험성 존재.<br>• A: 신기능 저하에 따른 항생제 등 약물 용량 조절(Dose adjustment) 필요.<br>• R: 처방 약물 용량 감량 검토 요청.`;
        }

        resBox.style.display = 'block';
        resBox.innerHTML = `<strong>산출 CrCl:</strong> ${crcl.toFixed(1)} mL/min<br><strong>용량 조절 가이드:</strong> ${guide} ${notiTemplate}`;
    }

    let savedPatientRecords = [];
    let currentLastAnalysis = null;
    
    // 데이터 불러오기 (파이어베이스 Firestore 연동)
    function loadSavedRecords() {
        if (db) {
            db.collection("patients").orderBy("id", "desc").get().then((querySnapshot) => {
                savedPatientRecords = [];
                querySnapshot.forEach((doc) => {
                    savedPatientRecords.push(doc.data());
                });
                renderSavedPatientList();
            }).catch((error) => {
                console.log("데이터 불러오기 실패:", error);
            });
        } else {
            const stored = localStorage.getItem('nurse_patient_records_v12');
            if (stored) {
                try { savedPatientRecords = JSON.parse(stored); } catch(e) { savedPatientRecords = []; }
            }
            renderSavedPatientList();
        }
    }

    function saveRecordsToStorage(recordObj) {
        if (db) {
            db.collection("patients").doc(String(recordObj.id)).set(recordObj).then(() => {
                loadSavedRecords();
                alert("클라우드에 안전하게 저장되었습니다!");
            }).catch((error) => {
                alert("클라우드 저장 실패: " + error.message);
            });
        } else {
            localStorage.setItem('nurse_patient_records_v12', JSON.stringify(savedPatientRecords));
            renderSavedPatientList();
        }
    }

    window.addEventListener('DOMContentLoaded', loadSavedRecords);

    document.getElementById('i_hdl').addEventListener('input', function() { document.getElementById('i_hdl_2').value = this.value; });
    document.getElementById('i_hdl_2').addEventListener('input', function() { document.getElementById('i_hdl').value = this.value; });

    function toggleCheckState(checkbox) {
        if (checkbox.checked) {
            checkbox.setAttribute('checked', 'checked');
        } else {
            checkbox.removeAttribute('checked');
        }
        updateCheckboxStatesInCurrentObj();
    }

    function updateCheckboxStatesInCurrentObj() {
        if (!currentLastAnalysis) return;
        const checkContainer = document.getElementById('out_patient_check');
        const treatContainer = document.getElementById('out_treatment_guide');
        if (checkContainer) currentLastAnalysis.patientCheckHtml = checkContainer.innerHTML;
        if (treatContainer) currentLastAnalysis.treatmentHtml = treatContainer.innerHTML;
    }

    // [분석 함수] - 수치를 분석하여 결과 HTML 생성
    function runAnalysis() {
        const ptNameInput = document.getElementById('i_pt_name').value.trim();
        const ptName = ptNameInput || '미명 환자';
        const dateStr = new Date().toLocaleDateString();

        const wbc = parseFloat(document.getElementById('i_wbc').value);
        let seg = parseFloat(document.getElementById('i_seg').value);
        const band = parseFloat(document.getElementById('i_band').value) || 0;
        const ast = parseFloat(document.getElementById('i_ast').value);
        const alt = parseFloat(document.getElementById('i_alt').value);
        const ggt = parseFloat(document.getElementById('i_ggt').value);
        const bun = parseFloat(document.getElementById('i_bun').value);
        const cr = parseFloat(document.getElementById('i_cr').value);
        const hdl = parseFloat(document.getElementById('i_hdl').value) || parseFloat(document.getElementById('i_hdl_2').value);
        const tg = parseFloat(document.getElementById('i_tg').value);
        const ldl = parseFloat(document.getElementById('i_ldl').value);
        const egfr = parseFloat(document.getElementById('i_egfr').value);
        const age = parseFloat(document.getElementById('i_age').value);
        const na = parseFloat(document.getElementById('i_na').value);
        const k = parseFloat(document.getElementById('i_k').value);
        const ptSec = parseFloat(document.getElementById('i_pt_sec').value);
        const ptInr = parseFloat(document.getElementById('i_pt_inr').value);

        let calcHtml = '';
        let notiHtml = '';
        let patientCheckListHtml = '';
        let treatmentListHtml = '';

        if (wbc) {
            let actualWbc = wbc < 100 ? wbc * 1000 : wbc;
            if (isNaN(seg)) seg = 60;
            const anc = actualWbc * ((seg + band) / 100);
            let badge = anc >= 1500 ? '<span class="badge badge-normal">정상</span>' : (anc >= 500 ? '<span class="badge badge-warning">감소</span>' : '<span class="badge badge-danger">위험</span>');
            
            calcHtml += `
                <div class="result-item">
                    <div class="result-item-title">절대호중구수 (ANC)</div>
                    <div class="result-item-val">${Math.round(anc)} /µL ${badge}</div>
                    <div style="font-size:0.7rem; color:#64748b;">공식: WBC(${actualWbc}) × (Seg%+Band%) / 100</div>
                </div>
            `;

            if (anc < 500) {
                notiHtml += `
                    <div class="sbar-card">
                        <h4>🚨 ANC &lt; 500 /µL (심각한 호중구 감소증)</h4>
                        <div class="sbar-line"><span class="sbar-lbl">S</span> "선생님, ${ptName} 님 오늘 CBC 결과 ANC ${Math.round(anc)}/µL로 급감하여 보고드립니다."</div>
                        <div class="sbar-line"><span class="sbar-lbl">B</span> "현재 WBC ${actualWbc}, Seg ${seg}% 상태입니다."</div>
                        <div class="sbar-line"><span class="sbar-lbl">A</span> "<span class="highlight-text">Neutropenic Fever 진행 고위험 상태</span>입니다."</div>
                        <div class="sbar-line"><span class="sbar-lbl">R</span> "즉시 역격리 실행 및 Culture 검사, G-CSF 처방 확인 부탁드립니다."</div>
                    </div>
                `;
                patientCheckListHtml += `
                    <div class="action-card">
                        <h4 style="color:var(--danger);">🛡️ 호중구 감소 사정 항목</h4>
                        <div class="interp-card">
                            <h4>🔴 ANC ${Math.round(anc)} /µL (Neutropenia)</h4>
                            <ul><li>면역 기능 극도 저하. BT &ge; 37.8℃ 시 Neutropenic Fever 진행 가능.</li></ul>
                        </div>
                        <ul class="check-item-list">
                            <li><label class="check-item-label"><input type="checkbox" onchange="toggleCheckState(this)"><span>발열(BT &ge; 37.8℃), 오한 유무 확인</span><span class="check-status-tag">확인</span></label></li>
                            <li><label class="check-item-label"><input type="checkbox" onchange="toggleCheckState(this)"><span>구강 궤양, 인후통, 피부 상처 부위 발적 사정</span><span class="check-status-tag">확인</span></label></li>
                        </ul>
                    </div>
                `;
                treatmentListHtml += `
                    <div class="action-card">
                        <h4 style="color:#15803d;">💊 호중구 감소 시 처치</h4>
                        <ul class="check-item-list">
                            <li><label class="check-item-label"><input type="checkbox" onchange="toggleCheckState(this)"><span><strong>역격리:</strong> 1인실 이동, 마스크 착용, 날음식 제한</span><span class="check-status-tag">확인</span></label></li>
                            <li><label class="check-item-label"><input type="checkbox" onchange="toggleCheckState(this)"><span><strong>검사/약물:</strong> Blood Culture × 2, G-CSF 투여 확인</span><span class="check-status-tag">확인</span></label></li>
                        </ul>
                    </div>
                `;
            }
        }

        if (ast || alt || ggt || ptInr) {
            let isAstAltAbnormal = (ast && ast > 38) || (alt && alt > 44);
            let isGgtAbnormal = ggt && ggt > 73;
            let isPtInrAbnormal = ptInr && ptInr > 1.2;

            if (ast && alt) {
                const astAltRatio = ast / alt;
                let badge = (!isAstAltAbnormal && astAltRatio >= 0.8 && astAltRatio <= 1.2) ? '<span class="badge badge-normal">정상</span>' : '<span class="badge badge-warning">주의</span>';
                if (isAstAltAbnormal) badge = '<span class="badge badge-danger">수치상승</span>';
                let ggtInfo = ggt ? ` (γ-GTP: ${ggt} IU/L)` : '';

                calcHtml += `
                    <div class="result-item">
                        <div class="result-item-title">AST / ALT 비율</div>
                        <div class="result-item-val">${astAltRatio.toFixed(2)} ${badge}</div>
                        <div style="font-size:0.7rem; color:#64748b;">AST: ${ast} / ALT: ${alt} U/L${ggtInfo}</div>
                    </div>
                `;

                if (isAstAltAbnormal || isPtInrAbnormal) {
                    let causeText = astAltRatio < 0.8 ? '비알코올성 지방간(ALT 우세)' : '알코올성/약물성 손상(AST 우세)';
                    let inrText = isPtInrAbnormal ? ` 및 PT/INR 연장(${ptInr}) 동반` : '';

                    notiHtml += `
                        <div class="sbar-card">
                            <h4>⚠️ 간수치 및 응고계 이상 <span class="noti-ref-text">(참고치: AST 7~38 / ALT 4~44 / INR 0.8~1.2)</span></h4>
                            <div class="sbar-line"><span class="sbar-lbl">S</span> "선생님, ${ptName} 님 LFT 상승(AST/ALT ${ast}/${alt}) 및 PT/INR ${ptInr || '측정안함'} 확인되어 보고드립니다."</div>
                            <div class="sbar-line"><span class="sbar-lbl">B</span> "AST/ALT 비율 ${astAltRatio.toFixed(2)}로 <span class="highlight-text">${causeText}${inrText} 의심</span>됩니다."</div>
                            <div class="sbar-line"><span class="sbar-lbl">A</span> "급성 간 손상에 따른 간 합성 능력 저하 및 출혈 경향 사정이 필요합니다."</div>
                            <div class="sbar-line"><span class="sbar-lbl">R</span> "간독성 약물 홀드 및 FFP/Vit K 투여 여부 검토 부탁드립니다."</div>
                        </div>
                    `;
                    patientCheckListHtml += `
                        <div class="action-card">
                            <h4 style="color:#b45309;">🍷 간 기능 & 응고계 사정 항목</h4>
                            <div class="interp-card">
                                <h4>🟡 LFT 상승 및 PT/INR 연장 해석</h4>
                                <ul><li>PT/INR 연장은 간 합성 기능 저하 또는 출혈 경향을 시사합니다.</li></ul>
                            </div>
                            <ul class="check-item-list">
                                <li><label class="check-item-label"><input type="checkbox" onchange="toggleCheckState(this)"><span>최근 음주력, 한약, 건강기능식품 복용 여부 확인</span><span class="check-status-tag">확인</span></label></li>
                                <li><label class="check-item-label"><input type="checkbox" onchange="toggleCheckState(this)"><span>잇몸 출혈, 멍(Ecchymosis), 흑색변(Melena) 유무 사정</span><span class="check-status-tag">확인</span></label></li>
                            </ul>
                        </div>
                    `;
                    treatmentListHtml += `
                        <div class="action-card">
                            <h4 style="color:#15803d;">💊 간 질환 & 출혈 경향 중재</h4>
                            <ul class="check-item-list">
                                <li><label class="check-item-label"><input type="checkbox" onchange="toggleCheckState(this)"><span><strong>약물 홀드:</strong> Acetaminophen, Statin 등 간독성 약물 홀드 노티</span><span class="check-status-tag">확인</span></label></li>
                                <li><label class="check-item-label"><input type="checkbox" onchange="toggleCheckState(this)"><span><strong>처방 확인:</strong> 간보호제(Godex/Ursosa) 및 Vit K / FFP 처방 확인</span><span class="check-status-tag">확인</span></label></li>
                            </ul>
                        </div>
                    `;
                }
            }

            if (!isAstAltAbnormal && isGgtAbnormal) {
                calcHtml += `
                    <div class="result-item">
                        <div class="result-item-title">γ-GTP (GGT) 단독 상승</div>
                        <div class="result-item-val">${ggt} IU/L <span class="badge badge-warning">단독상승</span></div>
                        <div style="font-size:0.7rem; color:#64748b;">참고치: 12~73 IU/L</div>
                    </div>
                `;
            }
        }

        if (bun || cr || k || na) {
            let isBunCrAbnormal = (bun && bun > 23.0) || (cr && cr > 1.20);
            let bunCrRatio = (bun && cr) ? (bun / cr) : 0;
            let isKAbnormal = k && (k > 5.5 || k < 3.5);

            if (bun && cr) {
                let badge = (!isBunCrAbnormal && bunCrRatio >= 10 && bunCrRatio < 20) ? '<span class="badge badge-normal">정상</span>' : '<span class="badge badge-warning">주의</span>';
                if (bunCrRatio >= 20 || isBunCrAbnormal) badge = '<span class="badge badge-danger">탈수/신손상의심</span>';

                calcHtml += `
                    <div class="result-item">
                        <div class="result-item-title">BUN / Cr 비율</div>
                        <div class="result-item-val">${bunCrRatio.toFixed(1)} : 1 ${badge}</div>
                        <div style="font-size:0.7rem; color:#64748b;">BUN: ${bun} / Cr: ${cr} mg/dL</div>
                    </div>
                `;
            }

            if (k) {
                let kBadge = (k >= 3.5 && k <= 5.5) ? '<span class="badge badge-normal">정상</span>' : '<span class="badge badge-danger">이상수치</span>';
                calcHtml += `
                    <div class="result-item">
                        <div class="result-item-title">칼륨 (K) 전해질</div>
                        <div class="result-item-val">${k} mmol/L ${kBadge}</div>
                        <div style="font-size:0.7rem; color:#64748b;">참고치: 3.5 ~ 5.5 mmol/L</div>
                    </div>
                `;
            }

            if (bunCrRatio >= 20 || isBunCrAbnormal || isKAbnormal) {
                let causeText = bunCrRatio >= 20 ? 'Prerenal 탈수 및 AKI 가능성' : 'Renal 신실질 손상 가능성';
                let kMsg = (k && k > 5.5) ? ' 및 고칼륨혈증(심정지 위험)' : '';

                notiHtml += `
                    <div class="sbar-card">
                        <h4>⚠️ 신장 기능 및 전해질 이상 <span class="noti-ref-text">(참고치: BUN 6~23 / Cr 0.6~1.2 / K 3.5~5.5)</span></h4>
                        <div class="sbar-line"><span class="sbar-lbl">S</span> "선생님, ${ptName} 님 BUN/Cr(${bun}/${cr}) 및 K+(${k || '미측정'}) 수치 이상으로 보고드립니다."</div>
                        <div class="sbar-line"><span class="sbar-lbl">B</span> "신장 여과능 저하 및 <span class="highlight-text">${causeText}${kMsg}</span>이 의심됩니다."</div>
                        <div class="sbar-line"><span class="sbar-lbl">A</span> "체액 부족 상태 및 고칼륨혈증에 따른 EKG 변화 모니터링이 필요합니다."</div>
                        <div class="sbar-line"><span class="sbar-lbl">R</span> "수액 공급(Hydration) 및 K+ 강하 처방(Kalimate) 확인 부탁드립니다."</div>
                    </div>
                `;
                patientCheckListHtml += `
                    <div class="action-card">
                        <h4 style="color:#b45309;">💧 신장 & 전해질 불균형 사정 항목</h4>
                        <div class="interp-card">
                            <h4>🔵 신장 지표 및 칼륨(K+) 불균형 해석</h4>
                            <ul><li>콩팥 기능 저하 시 칼륨 배설 장애로 고칼륨혈증 발생 위험이 매우 높음.</li></ul>
                        </div>
                        <ul class="check-item-list">
                            <li><label class="check-item-label"><input type="checkbox" onchange="toggleCheckState(this)"><span>24시간 소변량(Urine Output, Oliguria 유무) 철저 사정</span><span class="check-status-tag">확인</span></label></li>
                            <li><label class="check-item-label"><input type="checkbox" onchange="toggleCheckState(this)"><span>근육 약화, 마비감 및 서맥(Bradycardia) 증상 사정</span><span class="check-status-tag">확인</span></label></li>
                        </ul>
                    </div>
                `;
                treatmentListHtml += `
                    <div class="action-card">
                        <h4 style="color:#15803d;">💧 신장 보호 & 고칼륨혈증 처치</h4>
                        <ul class="check-item-list">
                            <li><label class="check-item-label"><input type="checkbox" onchange="toggleCheckState(this)"><span><strong>심전도:</strong> 고칼륨혈증 시 즉시 EKG 모니터링 (T파 뾰족함 확인)</span><span class="check-status-tag">확인</span></label></li>
                            <li><label class="check-item-label"><input type="checkbox" onchange="toggleCheckState(this)"><span><strong>수액 및 약물:</strong> Hydration 챌린지 및 Kalimate, 인슐린+포도당 믹스 준비</span><span class="check-status-tag">확인</span></label></li>
                        </ul>
                    </div>
                `;
            }
        }

        if (!calcHtml) calcHtml = '<p style="color:#ef4444; font-size:0.82rem; text-align:center; padding:20px 0;">입력된 수치가 없습니다.</p>';
        if (!notiHtml) notiHtml = '<p style="color:#10b981; font-size:0.82rem; text-align:center; padding:15px 0;">✅ 즉시 의사 노티가 필요한 뚜렷한 심각 이상 소견이 없습니다.</p>';
        if (!patientCheckListHtml) patientCheckListHtml = '<p style="color:#334155; font-size:0.82rem; text-align:center; padding:15px 0;">특이 사정 항목이 없습니다.</p>';
        if (!treatmentListHtml) treatmentListHtml = '<p style="color:#334155; font-size:0.82rem; text-align:center; padding:15px 0;">특이 중재 처치가 없습니다.</p>';

        document.getElementById('out_calc_list').innerHTML = calcHtml;
        document.getElementById('out_noti_list').innerHTML = notiHtml;
        document.getElementById('out_patient_check').innerHTML = patientCheckListHtml;
        document.getElementById('out_treatment_guide').innerHTML = treatmentListHtml;

        currentLastAnalysis = {
            name: ptName,
            date: dateStr,
            inputs: { wbc, seg, band, ast, alt, ggt, bun, cr, hdl, tg, ldl, egfr, age, na, k, ptSec, ptInr },
            calcHtml: calcHtml,
            notiHtml: notiHtml,
            patientCheckHtml: patientCheckListHtml,
            treatmentHtml: treatmentListHtml
        };

        return currentLastAnalysis;
    }

    // [저장 버튼 함수] - 분석을 안 했어도 입력된 내용이 있으면 자동으로 분석해서 곧바로 저장!
    function saveCurrentAnalysis() {
        let analysisData = currentLastAnalysis;
        
        // 만약 분석 버튼을 안 누르고 바로 저장 버튼을 눌렀다면 현재 입력값으로 즉시 분석 객체 생성
        if (!analysisData) {
            analysisData = runAnalysis();
        }

        const checkContainer = document.getElementById('out_patient_check');
        const treatContainer = document.getElementById('out_treatment_guide');
        if (checkContainer) analysisData.patientCheckHtml = checkContainer.innerHTML;
        if (treatContainer) analysisData.treatmentHtml = treatContainer.innerHTML;

        const recordObj = {
            id: Date.now(),
            name: analysisData.name,
            date: analysisData.date,
            inputs: analysisData.inputs,
            calcHtml: analysisData.calcHtml,
            notiHtml: analysisData.notiHtml,
            patientCheckHtml: analysisData.patientCheckHtml,
            treatmentHtml: analysisData.treatmentHtml
        };

        savedPatientRecords.unshift(recordObj);
        saveRecordsToStorage(recordObj);
    }

    function renderSavedPatientList() {
        const container = document.getElementById('saved_list_container');
        if (savedPatientRecords.length === 0) {
            container.innerHTML = `<p style="color:#94a3b8; font-size:0.8rem; text-align:center; padding:30px 0;">저장된 기록 없음</p>`;
            return;
        }

        let html = '';
        savedPatientRecords.forEach(rec => {
            html += `
                <div class="patient-list-item">
                    <div class="patient-info-click" onclick="loadPatientToMain(${rec.id})">
                        <span class="patient-name-txt">${rec.name}</span>
                        <span class="patient-date-txt">${rec.date}</span>
                    </div>
                    <button class="delete-btn" onclick="deletePatientRecord(event, ${rec.id})" title="삭제">🗑️</button>
                </div>
            `;
        });
        container.innerHTML = html;
    }

    function loadPatientToMain(id) {
        const rec = savedPatientRecords.find(r => r.id === id);
        if (!rec) return;

        document.getElementById('i_pt_name').value = rec.name;
        if (rec.inputs) {
            document.getElementById('i_wbc').value = rec.inputs.wbc || '';
            document.getElementById('i_seg').value = rec.inputs.seg || '';
            document.getElementById('i_band').value = rec.inputs.band || '0';
            document.getElementById('i_ast').value = rec.inputs.ast || '';
            document.getElementById('i_alt').value = rec.inputs.alt || '';
            document.getElementById('i_ggt').value = rec.inputs.ggt || '';
            document.getElementById('i_bun').value = rec.inputs.bun || '';
            document.getElementById('i_cr').value = rec.inputs.cr || '';
            document.getElementById('i_hdl').value = rec.inputs.hdl || '';
            document.getElementById('i_hdl_2').value = rec.inputs.hdl || '';
            document.getElementById('i_tg').value = rec.inputs.tg || '';
            document.getElementById('i_ldl').value = rec.inputs.ldl || '';
            document.getElementById('i_egfr').value = rec.inputs.egfr || '';
            document.getElementById('i_age').value = rec.inputs.age || '';
            document.getElementById('i_na').value = rec.inputs.na || '';
            document.getElementById('i_k').value = rec.inputs.k || '';
            document.getElementById('i_pt_sec').value = rec.inputs.ptSec || '';
            document.getElementById('i_pt_inr').value = rec.inputs.ptInr || '';
        }

        document.getElementById('out_calc_list').innerHTML = rec.calcHtml;
        document.getElementById('out_noti_list').innerHTML = rec.notiHtml;
        document.getElementById('out_patient_check').innerHTML = rec.patientCheckHtml;
        document.getElementById('out_treatment_guide').innerHTML = rec.treatmentHtml;

        currentLastAnalysis = rec;
    }

    function deletePatientRecord(e, id) {
        e.stopPropagation();
        if (db) {
            db.collection("patients").doc(String(id)).delete().then(() => {
                loadSavedRecords();
            }).catch((error) => {
                alert("삭제 실패: " + error.message);
            });
        } else {
            savedPatientRecords = savedPatientRecords.filter(r => r.id !== id);
            localStorage.setItem('nurse_patient_records_v12', JSON.stringify(savedPatientRecords));
            renderSavedPatientList();
        }
    }

    function resetForm() {
        document.querySelectorAll('.input-section input').forEach(inp => inp.value = '');
        document.getElementById('i_band').value = '0';
        currentLastAnalysis = null;
        document.getElementById('out_calc_list').innerHTML = '<p style="color:#94a3b8; font-size:0.82rem; text-align:center; padding:30px 0;">계산 수치가 표시됩니다.</p>';
        document.getElementById('out_noti_list').innerHTML = '<p style="color:#94a3b8; font-size:0.82rem; text-align:center; padding:15px 0;">SBAR 노티 템플릿이 자동 생성됩니다.</p>';
        document.getElementById('out_patient_check').innerHTML = '<p style="color:#94a3b8; font-size:0.82rem; text-align:center; padding:15px 0;">분석 결과가 여기에 표시됩니다.</p>';
        document.getElementById('out_treatment_guide').innerHTML = '<p style="color:#94a3b8; font-size:0.82rem; text-align:center; padding:15px 0;">중재 가이드가 표시됩니다.</p>';
    }
</script>

</body>
</html>
